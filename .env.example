# Copy to .env for `npm run dev`. Values here are for the local Defra ID stub
# (docker compose up cdp-defra-id-stub) and are public: never use them in a
# deployed environment.

APP_BASE_URL=http://localhost:3000

# Local CDP Defra ID stub
OIDC_DISCOVERY_URL=http://localhost:3200/cdp-defra-id-stub/.well-known/openid-configuration
OIDC_CLIENT_ID=63983fc2-cfff-45bb-8ec2-959e21062b9a
OIDC_CLIENT_SECRET=test_value
# The stub always issues this serviceId
OIDC_SERVICE_ID=e84a398b-8104-47a2-86ae-de1168e4132f
# The stub leaves the nonce out of its ID tokens (it saves it as oidcNonce but
# signs session.nonce). Never set this against real Defra ID.
OIDC_REQUIRE_NONCE=false

# Keeps CDP metrics local when running on the host
AWS_EMF_ENVIRONMENT=Local
